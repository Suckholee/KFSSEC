# KakaoTalk JavaScript SDK Key (From Kakao Developers Console https://developers.kakao.com)
VITE_KAKAO_JS_KEY=YOUR_KAKAO_JAVASCRIPT_KEY_HERE

# Kakao REST login: server-only values. Register this exact Redirect URI:
# http://localhost:3000/api/member-auth?action=callback
SITE_URL=http://localhost:3000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
MEMBER_SESSION_SECRET=

# Server only. Never prefix the service role key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_PASSWORD=CHOOSE_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=CHOOSE_A_RANDOM_64_CHARACTER_SECRET
